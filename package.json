    "example": "npm run build && node dist/examples/sync.js"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.18.12",
    "eslint": "^10.13.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2"
  }
}
