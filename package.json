{
  "name": "stellar-event-sync",
  "version": "0.1.0",
  "description": "Crash-consistent event ingestion primitives for Stellar RPC",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:site": "node scripts/build-site.mjs",
    "check:site": "node scripts/check-site.mjs",
    "check": "tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build && node --test dist/test/*.test.js",
    "example": "npm run build && node dist/examples/sync.js",
    "diagnostics": "npm run build && node dist/src/cli/index.js",
    "serve:site": "python3 -m http.server 4173 --directory web-dist"
  },
  "bin": {
    "stellar-event-sync-diagnostics": "dist/src/cli/index.js"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.18.12",
    "eslint": "^9.38.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
